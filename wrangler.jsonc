{
  // Cloudflare reads this file to host the app.
  "name": "entangledd-studio",
  "compatibility_date": "2026-06-20",
  // Keep the values entered in the Cloudflare dashboard (passcode, keys) when a new version deploys
  "keep_vars": true,
  // Server code for everything under /api/
  "main": "./server/worker.js",
  // "web" is the folder served as the app itself
  "assets": {
    "directory": "./web"
  },
  // Storage for uploaded backgrounds and finished reels
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "entangledd-media" }
  ],
  "vars": {
    "GITHUB_REPO": "YoNishu/entangledd-studio"
  },
  // Every day at 06:00 India time (00:30 UTC), prepare the day's quote suggestions
  "triggers": {
    "crons": ["30 0 * * *"]
  }
  // Secrets are added in the Cloudflare dashboard, not here:
  // APP_PASSCODE, RENDER_SECRET, GITHUB_TOKEN, ANTHROPIC_API_KEY, PEXELS_API_KEY
}
